#!/usr/bin/env bash
#
# bin/main — preview the site locally.
#
# The site is plain HTML/CSS/JS under docs/, with no build step, so this just
# serves that folder. Refresh the browser after editing a file.
#
# With ./bin on PATH (see .envrc), just run `main` from anywhere in the repo.
#
#   main          # serve on http://127.0.0.1:8000, or the next free port
#   main 9000     # serve on exactly this port (fails if it's taken)
#
# The SatSight demo (/site/satsight/) isn't committed: the Publish workflow
# downloads it from SatSight's "web-latest" release at deploy time. So the
# preview works the same, `main` downloads it the first time into the
# gitignored docs/site/satsight/. Delete that folder to pick up a newer one.
#
# While it serves, it also fetches every couple of seconds and fast-forwards to
# the upstream branch, as lab's main/watch does, so a push to GitHub shows up
# here on its own. Fast-forward only: uncommitted changes are kept, and a
# checkout with its own commits isn't moved (it says so once per upstream
# commit). MAIN_PULL_EVERY sets the seconds between looks (default 2; 0 is off).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

satsight="$root/docs/site/satsight"
if [ ! -f "$satsight/index.html" ]; then
  echo "Fetching the SatSight web demo into docs/site/satsight …" >&2
  tarball="$(mktemp -t satsight-web.XXXXXX)"
  if curl -fsSL -o "$tarball" \
      https://github.com/asvarga/SatSight/releases/download/web-latest/satsight-web.tar.gz \
    && mkdir -p "$satsight" && tar -xzf "$tarball" -C "$satsight"; then
    echo "  done" >&2
  else
    echo "  couldn't fetch it (offline?); /site/satsight/ will 404 in this preview" >&2
  fi
  rm -f "$tarball"
fi

# Pull in the background. The server below takes over this shell's PID (exec),
# so the loop stops once that PID is gone.
every="${MAIN_PULL_EVERY:-2}"
if [[ "$every" != 0 ]]; then
  (
    cd "$root" || exit
    server=$$
    stuck=""
    while sleep "$every" && kill -0 "$server" 2>/dev/null; do
      git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch -q 2>/dev/null || continue
      up="$(git rev-parse -q --verify '@{u}' 2>/dev/null)" || continue
      [[ -n "$(git rev-list -1 "HEAD..$up" 2>/dev/null)" ]] || continue
      [[ "$up" == "$stuck" ]] && continue
      if git merge -q --ff-only "$up" >/dev/null 2>&1; then
        stuck=""
        echo "pulled $(git rev-parse --short "$up")" >&2
      else
        stuck="$up"
        echo "can't fast-forward to $(git rev-parse --short "$up"): this checkout has its own commits, or local changes in the way" >&2
      fi
    done
  ) &
fi

# Python's `-m http.server` has no fallback when its port is busy (another
# `main`, or anything else on 8000), so bind here and walk up to a free port.
exec python3 - "$root/docs" "${1:-}" <<'PY'
import errno, functools, http.server, sys

docs, asked = sys.argv[1], sys.argv[2]
ports = [int(asked)] if asked else range(8000, 8100)
handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=docs)

for port in ports:
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", port), handler)
        break
    except OSError as e:
        if e.errno != errno.EADDRINUSE:
            raise
        print(f"Port {port} is in use", file=sys.stderr)
else:
    sys.exit(f"Try another port, e.g. `main {int(asked) + 1}`, or just `main`" if asked
             else "No free port found in 8000-8099")

print(f"Serving {docs} at http://127.0.0.1:{port}  (Ctrl-C to stop)", file=sys.stderr)
try:
    server.serve_forever()
except KeyboardInterrupt:
    pass
PY
