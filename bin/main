#!/usr/bin/env bash
#
# bin/main — serve the ProperDocs site locally with live reload.
#
# `properdocs serve` rebuilds the site and refreshes the browser whenever a
# source file under docs/ (or properdocs.yml) changes, so edits show up without
# a manual rebuild.
#
# With ./bin on PATH (see .envrc), just run `main` from anywhere in the repo.
#
#   main                 # serve on http://127.0.0.1:8000 with live reload
#   main -a 0.0.0.0:9000 # any extra args are passed through to `properdocs serve`
#   REBUILD=1 main       # recreate the venv from scratch before serving
#
# Dependency/venv bootstrap and the nix imaging-lib handoff live in bin/lib.sh.
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

exec "$venv/bin/properdocs" serve "$@"
