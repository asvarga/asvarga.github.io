#!/usr/bin/env bash
#
# bin/main — preview the site locally.
#
# The site is plain HTML/CSS/JS under docs/, with no build step, so this just
# serves that folder. Refresh the browser after editing a file.
#
# With ./bin on PATH (see .envrc), just run `main` from anywhere in the repo.
#
#   main          # serve on http://127.0.0.1:8000
#   main 9000     # serve on another port
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
port="${1:-8000}"

echo "Serving $root/docs at http://127.0.0.1:$port" >&2
exec python3 -m http.server "$port" --bind 127.0.0.1 --directory "$root/docs"
