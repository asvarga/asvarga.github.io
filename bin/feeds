#!/usr/bin/env python3
"""bin/feeds — regenerate docs/blog/feed.xml (Atom), docs/sitemap.xml and
docs/search.json.

The site has no build step; these files are derived from the pages, so
re-run this after adding, renaming or editing a page or post (`bin/check`
fails if they're stale):

    feeds            # rewrite all three files
    feeds --check    # exit 1 if any file is out of date (used by bin/check)

Posts are the pages under docs/blog/YYYY/MM/DD/<slug>/. The sitemap lists
every page that has the site shell (a canonical link to itself) except
redirects, the 404 page and anything marked <meta name="robots" content="noindex">.
search.json is a search index for other sites (GitHub Pages serves it with
CORS open): every sitemap page but the listings, with its kind, title, date,
tags, summary and text, plus each project card on the home page that has
no page of its own (`external: true` when it leaves the site).
"""
import html
import json
import re
import sys
from html.parser import HTMLParser
from pathlib import Path
from xml.sax.saxutils import escape

SITE = "https://asvarga.com"
DOCS = Path(__file__).resolve().parent.parent / "docs"


def meta(page, name):
    m = re.search(rf'<meta (?:name|property)="{re.escape(name)}" content="([^"]*)"', page)
    return html.unescape(m.group(1)) if m else ""


def canonical(page):
    m = re.search(r'<link rel="canonical" href="([^"]+)"', page)
    return m.group(1) if m else ""


def posts():
    out = []
    for f in DOCS.glob("blog/[0-9][0-9][0-9][0-9]/*/*/*/index.html"):
        page = f.read_text()
        title = html.unescape(re.search(r"<title>(.*?)</title>", page).group(1)).rsplit(" · ", 1)[0]
        date = re.search(r'<time datetime="(\d{4}-\d{2}-\d{2})"', page).group(1)
        tags = [html.unescape(t) for t in re.findall(r'class="tag"[^>]*>([^<]+)<', page.split('<div class="prose">')[0])]
        out.append(dict(title=title, date=date, url=canonical(page), summary=meta(page, "description"), tags=tags))
    return sorted(out, key=lambda p: p["date"], reverse=True)


def feed():
    ps = posts()
    entries = "".join(
        f"""  <entry>
    <title>{escape(p["title"])}</title>
    <link href="{p["url"]}"/>
    <id>{p["url"]}</id>
    <published>{p["date"]}T00:00:00Z</published>
    <updated>{p["date"]}T00:00:00Z</updated>
    <summary>{escape(p["summary"])}</summary>
{"".join(f'    <category term="{escape(t)}"/>{chr(10)}' for t in p["tags"])}  </entry>
"""
        for p in ps
    )
    return f"""<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Alexander Varga</title>
  <subtitle>Blog posts from asvarga.com</subtitle>
  <link href="{SITE}/blog/"/>
  <link rel="self" href="{SITE}/blog/feed.xml"/>
  <id>{SITE}/blog/</id>
  <author><name>Alexander Varga</name></author>
  <updated>{ps[0]["date"]}T00:00:00Z</updated>
{entries}</feed>
"""


def pages():
    """(url, html) of every page in the sitemap, in path order."""
    out = []
    for f in sorted(DOCS.rglob("*.html")):
        page = f.read_text(errors="ignore")
        url = canonical(page)
        rel = "/" + str(f.relative_to(DOCS)).removesuffix("index.html")
        if (not url.startswith(SITE) or url != SITE + rel or 'http-equiv="refresh"' in page
                or f.name == "404.html" or 'content="noindex"' in page):
            continue
        out.append((url, page))
    return out


def sitemap():
    body = "".join(f"  <url><loc>{escape(u)}</loc></url>\n" for u, _ in pages())
    return f'<?xml version="1.0" encoding="utf-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n{body}</urlset>\n'


class MainText(HTMLParser):
    """The words a reader sees in <main>, without its header, footer and nav."""

    SKIP = {"header", "footer", "nav", "script", "style", "svg", "button", "template"}
    VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"}
    # Inside a run of text, so no space at their edges ("post," not "post ,").
    INLINE = {"a", "abbr", "b", "code", "em", "i", "kbd", "mark", "q", "s", "small", "span", "strong", "sub", "sup", "u", "var"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.main = self.skip = 0
        self.parts = []

    def handle_starttag(self, tag, attrs):
        if tag == "main":
            self.main += 1
        elif self.main and tag not in self.VOID:
            if self.skip or tag in self.SKIP:
                self.skip += 1
            elif tag not in self.INLINE:
                self.parts.append(" ")

    def handle_endtag(self, tag):
        if tag == "main":
            self.main -= 1
        elif self.main and tag not in self.VOID:
            if self.skip:
                self.skip -= 1
            elif tag not in self.INLINE:
                self.parts.append(" ")

    def handle_data(self, data):
        if self.main and not self.skip:
            self.parts.append(data)


# Enough of any page to find it by; a long dump (the example trace) stops here.
TEXT_LIMIT = 20000


def main_text(page):
    parser = MainText()
    parser.feed(page)
    return " ".join("".join(parser.parts).split())[:TEXT_LIMIT]


def strip_tags(s):
    return " ".join(html.unescape(re.sub(r"<[^>]+>", " ", s)).split())


# The listings: they link to everything else, so they'd only crowd results.
LISTINGS = {f"{SITE}/", f"{SITE}/blog/", f"{SITE}/wiki/"}
# Projects sit at the top level, /<name>/.
KINDS = {"blog": "post", "wiki": "note"}


def search():
    """Everything another site needs to search this one: each post, project and
    note with its text, plus the projects that have no page here (built apps and
    external ones), from their cards on the home page."""
    entries = {}
    for url, page in pages():
        if url in LISTINGS:
            continue
        section = url.removeprefix(SITE + "/").split("/")[0]
        date = re.search(r'<time datetime="(\d{4}-\d{2}-\d{2})"', page)
        tags = [strip_tags(t) for t in re.findall(r'class="tag"[^>]*>(.*?)<', page.split('<div class="prose"')[0])]
        entries[url] = dict(
            url=url,
            kind=KINDS.get(section, "project"),
            title=html.unescape(re.search(r"<title>(.*?)</title>", page).group(1)).rsplit(" · ", 1)[0],
            date=date.group(1) if date and section == "blog" else None,
            tags=tags,
            summary=meta(page, "description"),
            text=main_text(page),
        )
    projects = (DOCS / "index.html").read_text()
    for card in re.findall(r'<li class="card"[^>]*>(.*?)</li>', projects, re.S):
        link = re.search(r'<h3>.*?<a href="([^"]+)"[^>]*>(.*?)</a>', card, re.S)
        if not link:
            continue
        href, title = html.unescape(link.group(1)), strip_tags(link.group(2))
        url = SITE + href if href.startswith("/") else href
        summary = strip_tags((re.search(r"<p>(.*?)</p>", card, re.S) or [None, ""])[1])
        tags = [strip_tags(t).lstrip("#") for t in re.findall(r'<span class="tag">(.*?)</span>', card)]
        if url in entries:
            entries[url]["tags"] = sorted(set(entries[url]["tags"]) | set(tags))
            continue
        entries[url] = dict(url=url, kind="project", title=title, date=None, tags=tags, summary=summary, text=summary)
        if not url.startswith(SITE + "/"):
            entries[url]["external"] = True
    return json.dumps(dict(version=1, site=SITE, entries=sorted(entries.values(), key=lambda e: e["url"])),
                      ensure_ascii=False, indent=1) + "\n"


def main():
    files = {DOCS / "blog/feed.xml": feed(), DOCS / "sitemap.xml": sitemap(), DOCS / "search.json": search()}
    if "--check" in sys.argv[1:]:
        stale = [str(p.relative_to(DOCS)) for p, text in files.items() if not p.exists() or p.read_text() != text]
        if stale:
            print("stale (run bin/feeds):", ", ".join(stale))
            sys.exit(1)
        return
    for p, text in files.items():
        p.write_text(text)
        print("wrote", p.relative_to(DOCS.parent))


if __name__ == "__main__":
    main()
