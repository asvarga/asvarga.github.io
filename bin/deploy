#!/usr/bin/env bash
#
# bin/deploy — publish the site to GitHub Pages.
#
# Publishing is done by the "Publish" GitHub Action (.github/workflows/main.yml):
# it copies docs/ as-is, adds the latest SatSight web demo, and force-pushes the
# result to the gh-pages branch, which is what asvarga.com serves. This script
# just starts that workflow on main and follows it until it finishes.
#
# With ./bin on PATH (see .envrc), just run `deploy` from anywhere in the repo.
#
#   deploy              # publish main
#   deploy my-branch    # publish another branch (e.g. to try a change live)
set -euo pipefail

ref="${1:-main}"

gh workflow run main.yml --ref "$ref"
echo "bin/deploy: started the Publish workflow on $ref; following it …" >&2
sleep 3
run_id="$(gh run list --workflow main.yml --branch "$ref" --limit 1 --json databaseId --jq '.[0].databaseId')"
exec gh run watch "$run_id" --exit-status
