# direnv: on `cd` into the repo, load the nix dev shell and put ./bin on PATH,
# so repo scripts (e.g. `main`) are callable by name. Run `direnv allow` once to
# trust this file. Requires nix (flakes) + direnv.
use flake ./nix

PATH_add bin

# Route 53 DNS for asvarga.com is managed with the `aws` CLI (from the flake)
# using a DNS-only IAM profile. Create it once with
# `aws configure --profile asvarga-dns`.
export AWS_PROFILE=asvarga-dns
